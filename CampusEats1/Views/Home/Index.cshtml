@{
    ViewData["Title"] = "CampusEats";
}

<section class="hero-panel">
    <div>
        <p class="eyebrow">Studentska menza</p>
        <h1>CampusEats</h1>
        <p class="lead">Brza rezervacija obroka, pregled dnevnog menija i sigurno QR preuzimanje za studente, radnike menze i kurire.</p>
        <div class="hero-actions">
            <a class="btn btn-primary" asp-controller="Meniji" asp-action="Index">Pogledaj meni</a>
            @if (User.IsInRole("Student") || User.IsInRole("Administrator"))
            {
                <a class="btn btn-outline-light" asp-controller="Rezervacije" asp-action="Create">Rezervisi obrok</a>
            }
            else
            {
                <a class="btn btn-outline-light" asp-controller="Account" asp-action="Login">Prijavi se</a>
            }
        </div>
        <div class="hero-highlights">
            <span>Online rezervacije</span>
            <span>QR potvrda</span>
            <span>Dostava obroka</span>
        </div>
    </div>
</section>

<section class="home-section">
    <div class="section-heading">
        <p class="eyebrow">Jednostavno i brzo</p>
        <h2>Kako funkcionise sistem?</h2>
        <p>Rezervacija i preuzimanje obroka zavrsavaju se u nekoliko jednostavnih koraka.</p>
    </div>
    <div class="steps-grid">
        <article>
            <div class="step-icon"><i data-lucide="utensils"></i></div>
            <span>Korak 1</span>
            <h3>Odaberite obrok</h3>
            <p>Pregledajte trenutni meni i odaberite obrok koji vam najvise odgovara.</p>
        </article>
        <article>
            <div class="step-icon"><i data-lucide="calendar-check"></i></div>
            <span>Korak 2</span>
            <h3>Izaberite termin</h3>
            <p>Rezervisite obrok, odaberite vrijeme i nacin na koji ga zelite preuzeti.</p>
        </article>
        <article>
            <div class="step-icon"><i data-lucide="qr-code"></i></div>
            <span>Korak 3</span>
            <h3>Preuzmite QR kod</h3>
            <p>Nakon rezervacije dobijate QR kod koji sluzi kao potvrda vase narudzbe.</p>
        </article>
        <article>
            <div class="step-icon"><i data-lucide="package-check"></i></div>
            <span>Korak 4</span>
            <h3>Preuzmite obrok</h3>
            <p>Pokazite QR kod radniku ili zavrsite dostavu uz brzu potvrdu preuzimanja.</p>
        </article>
    </div>
</section>

<section class="home-section about-band">
    <div class="about-copy">
        <p class="eyebrow">O nama</p>
        <h2>Studentska ishrana bez nepotrebnog cekanja</h2>
        <p>CampusEats je nastao kao digitalno rjesenje za jednostavnije koristenje studentske menze. Na jednom mjestu povezujemo pregled ponude, rezervaciju, licno preuzimanje i dostavu obroka.</p>
        <p>Cilj sistema je studentima ustedjeti vrijeme, olaksati planiranje obroka i uciniti cijeli proces preglednijim od rezervacije do zavrsene narudzbe.</p>
    </div>
    <div class="about-points">
        <div>
            <i data-lucide="clock-3"></i>
            <span><strong>Vise vremena za studente</strong>Rezervisite unaprijed i izbjegnite nepotrebno cekanje.</span>
        </div>
        <div>
            <i data-lucide="badge-check"></i>
            <span><strong>Sigurno preuzimanje</strong>QR potvrda jasno povezuje studenta i njegovu narudzbu.</span>
        </div>
        <div>
            <i data-lucide="heart-handshake"></i>
            <span><strong>Pristupacnija menza</strong>Licno preuzimanje i dostava prilagodjeni su potrebama studenata.</span>
        </div>
    </div>
</section>

<section class="home-section benefits-band">
    <div>
        <p class="eyebrow">Prednosti</p>
        <h2>Zasto koristiti CampusEats?</h2>
    </div>
    <div class="benefits-list">
        <span>Obrok se moze rezervisati unaprijed, pa je odlazak u menzu brzi i jednostavniji.</span>
        <span>Student odmah zna sta je dostupno i ne mora cekati u redu da sazna ponudu.</span>
        <span>QR potvrda smanjuje zabune oko preuzimanja i olaksava dokaz da je narudzba zavrsena.</span>
        <span>Dostava pomaze studentima koji ne mogu licno doci po obrok u dogovorenom terminu.</span>
    </div>
</section>

<section class="feature-grid">
    <a class="feature-card" asp-controller="Meniji" asp-action="Index">
        <span>01</span>
        <h2>Meni</h2>
        <p>Pregled obroka koji su trenutno u ponudi studentske menze.</p>
    </a>
    @if (User.IsInRole("Administrator") || User.IsInRole("RadnikMenze"))
    {
        <a class="feature-card" asp-controller="Obroci" asp-action="Index">
            <span>02</span>
            <h2>Obroci i zalihe</h2>
            <p>Pregled dostupnih jela, cijena, sastojaka i raspolozivih kolicina.</p>
        </a>
    }
    @if (SignInManager.IsSignedIn(User) && !User.IsInRole("Kurir"))
    {
        <a class="feature-card" asp-controller="Rezervacije" asp-action="Index">
            <span>03</span>
            <h2>Rezervacije</h2>
            <p>Historija rezervacija sa statusom, terminom i generisanim QR kodom.</p>
        </a>
    }
    @if (User.IsInRole("Kurir") || User.IsInRole("Administrator"))
    {
        <a class="feature-card" asp-controller="Kurir" asp-action="Index">
            <span>04</span>
            <h2>Dostava</h2>
            <p>Lista narudzbi koje su oznacene za dostavu i spremne za kurira.</p>
        </a>
    }
    @if (User.IsInRole("Administrator"))
    {
        <a class="feature-card" asp-controller="Administracija" asp-action="Index">
            <span>05</span>
            <h2>Administracija</h2>
            <p>Brzi pregled korisnika, obroka, rezervacija i aktivne ponude.</p>
        </a>
    }
</section>

@section Scripts {
    <script src="https://unpkg.com/lucide@0.468.0/dist/umd/lucide.min.js"></script>
    <script>window.lucide?.createIcons();</script>
}
