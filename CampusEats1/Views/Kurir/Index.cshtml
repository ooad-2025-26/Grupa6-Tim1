@model IEnumerable<Rezervacija>

@{
    ViewData["Title"] = "Kurir";
}

<div class="page-heading">
    <p class="eyebrow">Dostava</p>
    <h1>Narudzbe za dostavu</h1>
</div>

<div class="toolbar mb-3">
    <a class="btn btn-primary" asp-controller="QRCode" asp-action="Scan">Skeniraj QR narudzbe</a>
</div>

<table class="table app-table">
    <thead>
        <tr>
            <th>Student</th>
            <th>Adresa</th>
            <th>Obrok</th>
            <th>Termin</th>
            <th>Kurir</th>
            <th>Status</th>
            <th>QR za studenta</th>
            <th>Akcije</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var rezervacija in Model)
        {
            var kurirskiKod = rezervacija.QRKod is null
                ? null
                : $"KURIR:{rezervacija.Id}:{rezervacija.QRKod.Kod}";

            <tr>
                <td>@rezervacija.Korisnik?.Ime @rezervacija.Korisnik?.Prezime</td>
                <td>@rezervacija.Korisnik?.Adresa</td>
                <td>@rezervacija.Obrok?.Naziv</td>
                <td>@rezervacija.TerminPreuzimanja.ToString(@"hh\:mm")</td>
                <td>@(rezervacija.Kurir is null ? "Nije dodijeljeno" : $"{rezervacija.Kurir.Ime} {rezervacija.Kurir.Prezime}")</td>
                <td>@rezervacija.Status</td>
                <td>
                    @if (rezervacija.Status == StatusRezervacije.Preuzeta && kurirskiKod is not null)
                    {
                        var velikiQrUrl = $"https://api.qrserver.com/v1/create-qr-code/?size=420x420&data={Uri.EscapeDataString(kurirskiKod)}";
                        <button class="btn btn-sm btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#qrModal-@rezervacija.Id">
                            Prikazi QR kod
                        </button>
                        <div class="muted">Student skenira kod iz velikog prikaza.</div>

                        <div class="modal fade" id="qrModal-@rezervacija.Id" tabindex="-1" aria-labelledby="qrModalLabel-@rezervacija.Id" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h2 class="modal-title fs-5" id="qrModalLabel-@rezervacija.Id">QR kod za studenta</h2>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zatvori"></button>
                                    </div>
                                    <div class="modal-body text-center">
                                        <img class="qr-large" src="@velikiQrUrl" alt="Kurirski QR kod za rezervaciju #@rezervacija.Id" />
                                        <p class="mt-3 mb-0">Student skenira ovaj QR kod kada mu se narudzba dostavi.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else if (rezervacija.Status == StatusRezervacije.Dostavljena)
                    {
                        <span>Dostavljeno</span>
                    }
                    else
                    {
                        <span class="muted">Prvo skeniraj QR narudzbe.</span>
                    }
                </td>
                <td>
                    @if (rezervacija.KurirId is null)
                    {
                        <form asp-action="Preuzmi" asp-route-id="@rezervacija.Id" method="post">
                            <button class="btn btn-sm btn-primary" type="submit">Preuzmi dostavu</button>
                        </form>
                    }
                    else
                    {
                        <span class="muted">Dodijeljeno</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
