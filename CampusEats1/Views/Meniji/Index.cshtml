@model IEnumerable<Meni>

@{
    ViewData["Title"] = "Meni";
}

<div class="page-heading">
    <p class="eyebrow">Dnevni i sedmični pregled</p>
    <h1>Meni</h1>
    @if (User.IsInRole("Administrator") || User.IsInRole("RadnikMenze"))
    {
        <a class="btn btn-primary" asp-action="Create">Dodaj stavku menija</a>
    }
</div>

<table class="table app-table">
    <thead>
        <tr>
            <th>Datum</th>
            <th>Obrok</th>
            <th>Opis</th>
            <th>Cijena</th>
            @if (User.IsInRole("Administrator") || User.IsInRole("RadnikMenze"))
            {
                <th>Dostupnost</th>
            }
            <th>Akcije</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var meni in Model)
        {
            <tr>
                <td>@meni.Datum.ToString("dd.MM.yyyy")</td>
                <td>@meni.Obrok?.Naziv</td>
                <td>@meni.Obrok?.Opis</td>
                <td>@meni.Obrok?.Cijena.ToString("0.00") KM</td>
                @if (User.IsInRole("Administrator") || User.IsInRole("RadnikMenze"))
                {
                    <td>@(meni.Obrok?.Dostupan == true && meni.Obrok.Kolicina > 0 ? "Dostupno" : "Nedostupno")</td>
                }
                <td>
                    <a asp-action="Details" asp-route-id="@meni.Id">Detalji</a>
                    @if (User.IsInRole("Administrator") || User.IsInRole("RadnikMenze"))
                    {
                        <a asp-action="Edit" asp-route-id="@meni.Id">Uredi</a>
                        <a asp-action="Delete" asp-route-id="@meni.Id">Obriši</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
