@model IEnumerable<Obrok>

@{
    ViewData["Title"] = "Obroci";
}

<div class="page-heading">
    <p class="eyebrow">Ponuda menze</p>
    <h1>Obroci i zalihe</h1>
    @if (User.IsInRole("Administrator") || User.IsInRole("RadnikMenze"))
    {
        <a class="btn btn-primary" asp-action="Create">Dodaj obrok</a>
    }
</div>

<div class="meal-grid">
    @foreach (var obrok in Model)
    {
        <article class="meal-card">
            <div class="meal-card__top">
                <h2>@obrok.Naziv</h2>
                <strong>@obrok.Cijena.ToString("0.00") KM</strong>
            </div>
            <p>@obrok.Opis</p>
            <p class="muted">Sastojci: @obrok.Sastojci</p>
            <div class="meal-meta">
                <span>Količina: @obrok.Kolicina</span>
                <span class="status @(obrok.Dostupan ? "status-ok" : "status-off")">
                    @(obrok.Dostupan ? "Dostupan" : "Nedostupan")
                </span>
            </div>
            <div class="action-links">
                <a asp-action="Details" asp-route-id="@obrok.Id">Detalji</a>
                @if (User.IsInRole("Administrator") || User.IsInRole("RadnikMenze"))
                {
                    <a asp-action="Edit" asp-route-id="@obrok.Id">Uredi</a>
                    <a asp-action="Delete" asp-route-id="@obrok.Id">Obriši</a>
                }
            </div>
        </article>
    }
</div>
