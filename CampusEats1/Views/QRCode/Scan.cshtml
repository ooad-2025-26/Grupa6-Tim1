@{
    ViewData["Title"] = "QR evidencija";
    var rezervacija = ViewBag.Rezervacija as Rezervacija;
    var kurirskiKod = rezervacija?.QRKod is null
        ? null
        : $"KURIR:{rezervacija.Id}:{rezervacija.QRKod.Kod}";
    var kurirskiQrUrl = string.IsNullOrWhiteSpace(kurirskiKod)
        ? null
        : $"https://api.qrserver.com/v1/create-qr-code/?size=180x180&data={Uri.EscapeDataString(kurirskiKod)}";
}

<div class="page-heading">
    <p class="eyebrow">Vanjski uredjaj</p>
    <h1>QR evidencija</h1>
</div>

@if (ViewBag.Poruka is not null)
{
    <div class="alert alert-success">@ViewBag.Poruka</div>
}

<section class="scan-layout">
    <form asp-action="Scan" class="app-form" id="qrScanForm">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <label for="kod">QR kod</label>
        <input id="kod" name="kod" class="form-control" placeholder="Unesite ili skenirajte kod" />

        <div class="scan-actions">
            <button class="btn btn-outline-secondary" id="startScan" type="button">Pokreni kameru</button>
            <button class="btn btn-outline-secondary" id="stopScan" type="button">Zaustavi</button>
        </div>

        <button class="btn btn-primary" type="submit">Evidentiraj</button>
    </form>

    <div class="camera-panel">
        <div id="qrReader"></div>
        <p class="muted" id="cameraStatus">Kamera ocitava QR kod kada je stranica otvorena preko HTTPS-a ili localhosta.</p>
    </div>
</section>

@if (rezervacija is not null)
{
    <section class="details-panel mt-3">
        <div class="status-result">
            <span class="status-label">Status narudzbe</span>
            <strong>@rezervacija.Status</strong>
        </div>
        <dl>
            <dt>Broj narudzbe</dt>
            <dd>#@rezervacija.Id</dd>
            <dt>Student</dt>
            <dd>@rezervacija.Korisnik?.Ime @rezervacija.Korisnik?.Prezime</dd>
            <dt>Obrok</dt>
            <dd>@rezervacija.Obrok?.Naziv</dd>
            <dt>Termin preuzimanja</dt>
            <dd>@rezervacija.TerminPreuzimanja.ToString(@"hh\:mm")</dd>
            <dt>Nacin preuzimanja</dt>
            <dd>@rezervacija.NacinPreuzimanja</dd>
            @if (rezervacija.Kurir is not null)
            {
                <dt>Kurir</dt>
                <dd>@rezervacija.Kurir.Ime @rezervacija.Kurir.Prezime</dd>
            }
        </dl>
        @if ((User.IsInRole("Kurir") || User.IsInRole("Administrator"))
            && rezervacija.NacinPreuzimanja == NacinPreuzimanja.Dostava
            && rezervacija.Status == StatusRezervacije.Preuzeta
            && kurirskiQrUrl is not null)
        {
            <div class="qr-display mt-3">
                <strong>QR kod za studenta</strong>
                <img src="@kurirskiQrUrl" alt="Kurirski QR kod za rezervaciju #@rezervacija.Id" />
                <span class="muted">Student skenira ovaj QR kod kada mu se narudzba dostavi.</span>
            </div>
        }
    </section>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
    <script>
        const readerElementId = "qrReader";
        const kodInput = document.getElementById("kod");
        const qrScanForm = document.getElementById("qrScanForm");
        const startButton = document.getElementById("startScan");
        const stopButton = document.getElementById("stopScan");
        const statusText = document.getElementById("cameraStatus");
        let html5QrCode;

        function setStatus(message) {
            if (statusText) {
                statusText.textContent = message;
            }
        }

        function loadBackupScannerLibrary() {
            return new Promise(resolve => {
                if (window.Html5Qrcode) {
                    resolve(true);
                    return;
                }

                const script = document.createElement("script");
                script.src = "https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js";
                script.onload = () => resolve(Boolean(window.Html5Qrcode));
                script.onerror = () => resolve(false);
                document.head.appendChild(script);
            });
        }

        async function startScanner() {
            const scannerLoaded = await loadBackupScannerLibrary();
            if (!scannerLoaded) {
                setStatus("QR citac se nije ucitao. Provjerite internet ili koristite rucni unos QR koda.");
                return;
            }

            await stopScanner();
            html5QrCode = new Html5Qrcode(readerElementId);

            setStatus("Kamera je aktivna. Usmjerite QR kod prema kameri.");
            await html5QrCode.start(
                { facingMode: "environment" },
                {
                    fps: 10,
                    qrbox: { width: 250, height: 250 }
                },
                async value => {
                    kodInput.value = value;
                    setStatus("QR kod je ocitan. Evidencija se obradjuje...");
                    await stopScanner();
                    qrScanForm?.submit();
                },
                () => { }
            );
        }

        async function stopScanner() {
            if (html5QrCode?.isScanning) {
                await html5QrCode.stop();
                await html5QrCode.clear();
            }
            html5QrCode = null;
        }

        startButton?.addEventListener("click", async () => {
            try {
                await startScanner();
            } catch {
                setStatus("Kamera nije dostupna. Provjerite dozvolu browsera i HTTPS.");
            }
        });

        stopButton?.addEventListener("click", async () => {
            await stopScanner();
            setStatus("Kamera je zaustavljena.");
        });

        window.addEventListener("beforeunload", () => {
            if (html5QrCode?.isScanning) {
                html5QrCode.stop();
            }
        });

        if (!window.isSecureContext) {
            setStatus("Za kameru je potreban HTTPS ili localhost. Online HTTP link dozvoljava samo rucni unos.");
        }
    </script>
}
