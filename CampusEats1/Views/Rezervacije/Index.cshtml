@model IEnumerable<Rezervacija>

@{
    ViewData["Title"] = "Rezervacije";
}

<div class="page-heading page-heading-row">
    <div>
        <p class="eyebrow">Narudžbe</p>
        <h1>Rezervacije</h1>
    </div>
    <a class="btn btn-primary" asp-action="Create">Nova rezervacija</a>
</div>

<table class="table app-table">
    <thead>
        <tr>
            <th>Student</th>
            <th>Obrok</th>
            <th>Termin</th>
            <th>Način</th>
            <th>Status</th>
            <th>QR kod</th>
            <th>Akcije</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var rezervacija in Model)
        {
            <tr>
                <td>@rezervacija.Korisnik?.Ime @rezervacija.Korisnik?.Prezime</td>
                <td>@rezervacija.Obrok?.Naziv</td>
                <td>@rezervacija.TerminPreuzimanja.ToString(@"hh\:mm")</td>
                <td>@rezervacija.NacinPreuzimanja</td>
                <td><span class="status status-ok">@rezervacija.Status</span></td>
                <td><code>@rezervacija.QRKod?.Kod</code></td>
                <td>
                    <a asp-action="Details" asp-route-id="@rezervacija.Id">Detalji</a>
                    @if (User.IsInRole("Administrator") || User.IsInRole("RadnikMenze"))
                    {
                        <a asp-action="Edit" asp-route-id="@rezervacija.Id">Uredi</a>
                        <a asp-action="Delete" asp-route-id="@rezervacija.Id">Obriši</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
