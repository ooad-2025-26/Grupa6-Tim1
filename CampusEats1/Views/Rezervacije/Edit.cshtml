@model Rezervacija

@{
    ViewData["Title"] = "Uredi rezervaciju";
    var samoStatus = User.IsInRole("RadnikMenze") && !User.IsInRole("Administrator");
}

<div class="page-heading">
    <p class="eyebrow">CRUD</p>
    <h1>Uredi rezervaciju</h1>
</div>

<form asp-action="Edit" class="app-form">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    @if (samoStatus)
    {
        <input type="hidden" asp-for="KorisnikId" />
        <input type="hidden" asp-for="ObrokId" />
        <input type="hidden" asp-for="Datum" />
        <input type="hidden" asp-for="TerminPreuzimanja" />
        <input type="hidden" asp-for="NacinPreuzimanja" />

        <div class="readonly-grid">
            <span>Student</span>
            <strong>@Model.Korisnik?.Ime @Model.Korisnik?.Prezime</strong>
            <span>Obrok</span>
            <strong>@Model.Obrok?.Naziv</strong>
            <span>Datum narudzbe</span>
            <strong>@Model.Datum.ToString("dd.MM.yyyy HH:mm")</strong>
            <span>Termin preuzimanja</span>
            <strong>@Model.TerminPreuzimanja.ToString(@"hh\:mm")</strong>
            <span>Nacin preuzimanja</span>
            <strong>@Model.NacinPreuzimanja</strong>
        </div>
    }
    else
    {
        <label asp-for="KorisnikId">Student</label>
        <select asp-for="KorisnikId" asp-items="ViewBag.KorisnikId" class="form-select"></select>

        <label asp-for="ObrokId">Obrok</label>
        <select asp-for="ObrokId" asp-items="ViewBag.ObrokId" class="form-select"></select>

        <label asp-for="Datum"></label>
        <input asp-for="Datum" class="form-control" />

        <label asp-for="TerminPreuzimanja">Termin preuzimanja</label>
        <input asp-for="TerminPreuzimanja" class="form-control" type="time" />

        <label asp-for="NacinPreuzimanja">Nacin preuzimanja</label>
        <select asp-for="NacinPreuzimanja" asp-items="Html.GetEnumSelectList<NacinPreuzimanja>()" class="form-select"></select>
    }

    <label asp-for="Status"></label>
    <select asp-for="Status" asp-items="Html.GetEnumSelectList<StatusRezervacije>()" class="form-select"></select>

    <button class="btn btn-primary" type="submit">Sacuvaj izmjene</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Nazad</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
