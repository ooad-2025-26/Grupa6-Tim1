@model CampusEats.Models.Rezervacija

@{
    ViewData["Title"] = "Edit Reservation";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card reservation-card">
                <div class="card-body">
                    <h2 class="reservation-title">Edit Reservation</h2>

                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label class="form-label">Meal</label>
                            <select asp-for="ObrokId" class="form-select" asp-items="ViewBag.ObrokId"></select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Date</label>
                            <input asp-for="Datum" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Status</label>
                            <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<CampusEats.Models.StatusRezervacije>()"></select>
                        </div>

                        <div class="d-flex">
                            <button type="submit" class="btn btn-success">Save Changes</button>
                            <a asp-action="Index" class="btn btn-outline-secondary ms-2">Back to Reservations</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
