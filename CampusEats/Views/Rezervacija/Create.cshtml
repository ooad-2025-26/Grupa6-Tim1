@model CampusEats.Models.Rezervacija

@{
    ViewData["Title"] = "Confirm Reservation";
}

@section Styles {
    <link rel="stylesheet" href="~/css/menu.css" />
}

@{
    // Determine selected meal name from ViewData["ObrokId"] SelectList if available
    var select = ViewData["ObrokId"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    string mealName = null;
    if (select != null)
    {
        var selected = select.Where(s => s.Value == (Model?.ObrokId.ToString() ?? "")).FirstOrDefault();
        if (selected != null) mealName = selected.Text;
    }
}

<div class="menu-wrapper">
    <div class="menu-inner">
        <div class="reservation-card">
            <h1 class="reservation-title">Confirm Reservation</h1>
            <div class="reservation-grid">
                <div class="reservation-image">
                    @{
                        // attempt to display meal image if available via TempData or other; fallback to placeholder
                        var obroci = ViewData["ObrokId"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
                    }
                    <img src="/images/food-placeholder.png" alt="Meal image" />
                </div>
                <div class="reservation-info">
                    <h2 class="meal-name">@(!string.IsNullOrEmpty(mealName) ? mealName : "Selected Meal")</h2>
                    <div class="reservation-meta">
                        <div><strong>Date:</strong> @Model?.Datum.ToString("g")</div>
                        <div><strong>Status:</strong> @Model?.Status.ToString()</div>
                    </div>

                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ObrokId" value="@Model?.ObrokId" />
                        <div class="form-actions">
                            <button type="submit" class="reserve-btn">Confirm Reservation</button>
                            <a class="btn btn-link" asp-controller="Obrok" asp-action="Index">Back to Menu</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
