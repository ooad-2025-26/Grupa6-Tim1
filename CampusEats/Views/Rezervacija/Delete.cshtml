@model CampusEats.Models.Rezervacija

@{
    ViewData["Title"] = "Cancel Reservation";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card reservation-card">
                <div class="card-body">
                    <h2 class="reservation-title">Cancel Reservation</h2>

                    <p>Are you sure you want to cancel the following reservation?</p>

                    <div class="mb-2"><strong>Meal:</strong> @(Model.Obrok?.Naziv ?? "Unknown")</div>
                    <div class="mb-2"><strong>Student:</strong> @(Model.Korisnik?.Email ?? "-")</div>
                    <div class="mb-2"><strong>Date:</strong> @Model.Datum.ToString("g")</div>

                    <form asp-action="Delete" method="post" class="mt-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <button type="submit" class="btn btn-danger">Confirm Cancel</button>
                        <a asp-action="Index" class="btn btn-outline-secondary ms-2">Back to Reservations</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
