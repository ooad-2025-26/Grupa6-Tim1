@model CampusEats.Models.Rezervacija

@{
    ViewData["Title"] = "Reservation Details";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card reservation-card">
                <div class="card-body">
                    <h2 class="reservation-title mb-3">Reservation Details</h2>

                    <div class="mb-3">
                        <strong>Meal:</strong> @(Model.Obrok?.Naziv ?? "Unknown")
                    </div>
                    <div class="mb-3">
                        <strong>Student:</strong> @(Model.Korisnik?.Email ?? "-")
                    </div>
                    <div class="mb-3">
                        <strong>Date:</strong> @Model.Datum.ToString("g")
                    </div>
                    <div class="mb-3">
                        <strong>Status:</strong> @Model.Status
                    </div>

                    <div class="mt-4">
                        @if (User.IsInRole("Student") && Model.Korisnik?.UserName == User.Identity.Name)
                        {
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-success me-2">Edit Reservation</a>
                            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Cancel Reservation</a>
                        }
                        else if (User.IsInRole("Radnik") || User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-success me-2">Update Status</a>
                            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete Reservation</a>
                        }

                        <a asp-action="Index" class="btn btn-outline-secondary ms-2">Back to Reservations</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
