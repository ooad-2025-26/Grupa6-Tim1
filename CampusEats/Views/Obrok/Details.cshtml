@model CampusEats.Models.Obrok

@{
    ViewData["Title"] = "Meal Details";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card reservation-card">
                <div class="card-body">
                    <h2 class="meal-name">@Model.Naziv</h2>
                    <div class="mb-3">@Model.Opis</div>
                    <div class="mb-3"><strong>Price:</strong> @Model.Cijena.ToString("C")</div>

                    <div class="mt-3">
                        <a asp-controller="Rezervacija" asp-action="Create" asp-route-obrokId="@Model.Id" class="btn btn-success">Reserve</a>
                        <a asp-controller="Obrok" asp-action="Index" class="btn btn-outline-secondary ms-2">Back to Menu</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
