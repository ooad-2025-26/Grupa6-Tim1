@{
    ViewData["Title"] = "CampusEats";
}

<link rel="stylesheet" href="/css/home.css" />

<section class="hero">

    <div class="hero-left">

        <h1>
            Fast Food Delivery For Students
        </h1>

        <p>
            Order delicious meals around your campus quickly and easily.
        </p>

        <div class="hero-buttons">

            <button class="btn-order">
                Order Now
            </button>

            <button class="btn-menu">
                Explore Menu
            </button>

        </div>

    </div>

    <div class="hero-right">

        <img src="https://images.unsplash.com/photo-1504674900247-0877df9cc836"
             alt="Food Image">

    </div>

</section>

<section class="popular-food">

    <h2>Popularna jela</h2>

    <div class="food-container">

        <div class="food-card">

            <img src="https://images.unsplash.com/photo-1568901346375-23c9450c58cd">

            <div class="food-info">

                <h3>Cheese Burger</h3>

                <p>⭐ 4.8 • 15 min</p>

                <h4>8.99 KM</h4>

                <button>Naruči</button>

            </div>

        </div>

        <div class="food-card">

            <img src="https://images.unsplash.com/photo-1513104890138-7c749659a591">

            <div class="food-info">

                <h3>Pizza Capricciosa</h3>

                <p>⭐ 4.9 • 20 min</p>

                <h4>12.50 KM</h4>

                <button>Naruči</button>

            </div>

        </div>

        <div class="food-card">

            <img src="https://images.unsplash.com/photo-1559847844-d721426d6edc">

            <div class="food-info">

                <h3>Chicken Sandwich</h3>

                <p>⭐ 4.7 • 10 min</p>

                <h4>7.50 KM</h4>

                <button>Naruči</button>

            </div>

        </div>

    </div>

</section>

<section class="about-section">

    <div class="about-left">

        <img src="https://images.unsplash.com/photo-1528605248644-14dd04022da1"
             alt="Students eating">

    </div>

    <div class="about-right">

        <h2>O nama</h2>

        <p>
            CampusEats je aplikacija namijenjena studentima koja omogućava
            brzo pregledanje menija, rezervaciju obroka i preuzimanje hrane
            bez čekanja u redu.
        </p>

        <p>
            Naš cilj je studentima olakšati svakodnevnu ishranu i omogućiti
            jednostavno korištenje restoranskih usluga putem moderne web aplikacije.
        </p>


    </div>

</section>


<footer class="footer">

    <div class="footer-left">

        <h3>CampusEats</h3>

        <a href="#">Lokacija</a>
        <a href="#">O nama</a>
        <a href="#">Kontakt</a>

    </div>

    <div class="footer-right">

        <a href="#">Instagram</a>
        <a href="#">X</a>

    </div>

</footer>