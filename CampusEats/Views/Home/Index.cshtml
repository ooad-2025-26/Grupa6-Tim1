@{
    ViewData["Title"] = "CampusEats";
}

<link rel="stylesheet" href="/css/home.css" />

@if (!(User?.Identity?.IsAuthenticated ?? false))
{
    <section class="hero" id="hero">

        <div class="hero-left">

            <h1>
                Reserve your meal quickly and without waiting
            </h1>

            <p>
                Browse the daily menu, choose your meal, and pick it up easily using a QR code.
            </p>

            <div class="hero-buttons">

                @if (User?.Identity?.IsAuthenticated ?? false)
                {
                    <a class="btn-order" asp-controller="Rezervacija" asp-action="Create">Order Now</a>
                }
                else
                {
                    <a class="btn-order" asp-controller="Account" asp-action="Login" asp-route-returnUrl="~/Rezervacija/Create">Order Now</a>
                }

                <a class="btn-menu" asp-controller="Home" asp-action="Index" asp-fragment="popular-food">Explore Menu</a>

            </div>

        </div>

        <div class="hero-right">

            <img src="https://images.unsplash.com/photo-1504674900247-0877df9cc836"
                 alt="Food Image">

        </div>

    </section>
}
else
{
    <section class="dashboard">
        <div class="container">
            <h2>Welcome back, @User.Identity.Name</h2>
            <div class="dashboard-cards">
                @if (User.IsInRole("Student"))
                {
                    <a class="card" asp-controller="Obrok" asp-action="Index">Browse Menu</a>
                    <a class="card" asp-controller="Rezervacija" asp-action="Index">My Reservations</a>
                    <a class="card" asp-controller="QRKod" asp-action="Index">My QR Codes</a>
                    <a class="card" asp-controller="Profile" asp-action="Index">Profile</a>
                }
                else if (User.IsInRole("Radnik"))
                {
                    <a class="card" asp-controller="Obrok" asp-action="Index">Manage Meals</a>
                    <a class="card" asp-controller="Meni" asp-action="Index">Manage Menus</a>
                    <a class="card" asp-controller="Rezervacija" asp-action="Index">View Reservations</a>
                    <a class="card" asp-controller="Zaliha" asp-action="Index">Manage Stock</a>
                }
                else if (User.IsInRole("Dostavljac"))
                {
                    <a class="card" asp-controller="Dostava" asp-action="Index">Assigned Deliveries</a>
                    <a class="card" asp-controller="Dostava" asp-action="Index">Update Delivery Status</a>
                    <a class="card" asp-controller="Profile" asp-action="Index">Profile</a>
                }
                else if (User.IsInRole("Admin"))
                {
                    <a class="card" asp-controller="Admin" asp-action="Users">User Management</a>
                    <a class="card" asp-controller="Admin" asp-action="Roles">Role Management</a>
                    <a class="card" asp-controller="Obrok" asp-action="Index">Meals</a>
                    <a class="card" asp-controller="Meni" asp-action="Index">Menus</a>
                    <a class="card" asp-controller="Rezervacija" asp-action="Index">Reservations</a>
                    <a class="card" asp-controller="Dostava" asp-action="Index">Deliveries</a>
                    <a class="card" asp-controller="Zaliha" asp-action="Index">Stock</a>
                }
            </div>
        </div>
    </section>
}

<section class="how-section meals" id="how">
    <h2 class="section-title">How CampusEats Works</h2>
    <div class="meal-cards">
        <div class="meal-card">
            <img src="https://images.unsplash.com/photo-1555992336-03a23cbb6e58" alt="Browse menu">
            <h3>Browse Menu</h3>
            <p>Check daily meals and prices.</p>
        </div>
        <div class="meal-card">
            <img src="https://images.unsplash.com/photo-1499028344343-cd173ffc68a9" alt="Reserve">
            <h3>Reserve</h3>
            <p>Select a meal and reserve it for pickup.</p>
        </div>
        <div class="meal-card">
            <img src="https://images.unsplash.com/photo-1541544180-9a2f1df3b9d8" alt="Pickup">
            <h3>Pickup with QR</h3>
            <p>Show your QR code and pick up quickly.</p>
        </div>
    </div>
</section>

<section class="popular-food" id="popular-food">

    <h2>Popular Meals</h2>

    <div class="food-container">

        <div class="food-card">

            <img src="https://images.unsplash.com/photo-1568901346375-23c9450c58cd">

            <div class="food-info">

                <h3>Cheese Burger</h3>

                <p>⭐ 4.8 • 15 min</p>

                <h4>8.99 KM</h4>

                @if (User?.Identity?.IsAuthenticated ?? false)
                {
                    <a class="food-info-btn btn-order" asp-controller="Rezervacija" asp-action="Create">Order</a>
                }
                else
                {
                    <a class="food-info-btn btn-order" asp-controller="Account" asp-action="Login" asp-route-returnUrl="~/Rezervacija/Create">Order</a>
                }

            </div>

        </div>

        <div class="food-card">

            <img src="https://images.unsplash.com/photo-1513104890138-7c749659a591">

            <div class="food-info">

                <h3>Pizza Capricciosa</h3>

                <p>⭐ 4.9 • 20 min</p>

                <h4>12.50 KM</h4>

                @if (User?.Identity?.IsAuthenticated ?? false)
                {
                    <a class="food-info-btn btn-order" asp-controller="Rezervacija" asp-action="Create">Order</a>
                }
                else
                {
                    <a class="food-info-btn btn-order" asp-controller="Account" asp-action="Login" asp-route-returnUrl="~/Rezervacija/Create">Order</a>
                }

            </div>

        </div>

        <div class="food-card">

            <img src="https://images.unsplash.com/photo-1559847844-d721426d6edc">

            <div class="food-info">

                <h3>Chicken Sandwich</h3>

                <p>⭐ 4.7 • 10 min</p>

                <h4>7.50 KM</h4>

                @if (User?.Identity?.IsAuthenticated ?? false)
                {
                    <a class="food-info-btn btn-order" asp-controller="Rezervacija" asp-action="Create">Order</a>
                }
                else
                {
                    <a class="food-info-btn btn-order" asp-controller="Account" asp-action="Login" asp-route-returnUrl="~/Rezervacija/Create">Order</a>
                }

            </div>

        </div>

    </div>

</section>

<section class="meals" id="benefits">
    <h2 class="section-title">Why Use CampusEats</h2>
    <div class="meal-cards">
        <div class="meal-card">
            <img src="https://images.unsplash.com/photo-1543353071-873f17a7a088" alt="speed">
            <h3>Fast Pickup</h3>
            <p>Skip the line and save time.</p>
        </div>
        <div class="meal-card">
            <img src="https://images.unsplash.com/photo-1512621776951-a57141f2eefd" alt="variety">
            <h3>Daily Variety</h3>
            <p>Fresh meals every day.</p>
        </div>
        <div class="meal-card">
            <img src="https://images.unsplash.com/photo-1512621776951-a57141f2eefd" alt="easy">
            <h3>Easy to Use</h3>
            <p>Simple interface for quick reservations.</p>
        </div>
    </div>
</section>

<section class="about-section" id="about">

    <div class="about-left">

        <img src="https://images.unsplash.com/photo-1528605248644-14dd04022da1"
             alt="Students eating">

    </div>

    <div class="about-right">

        <h2>About Us</h2>

        <p>
            CampusEats is an application for students that enables quick menu browsing, meal reservations and pickup without waiting in line.
        </p>

        <p>
            Our goal is to make daily meals easier for students and provide a simple way to use restaurant services through a modern web application.
        </p>


    </div>

</section>


<footer class="footer">

    <div class="footer-left">

        <h3>CampusEats</h3>

        <a href="#">Location</a>
        <a href="#about">About Us</a>
        <a href="#">Contact</a>

    </div>

    <div class="footer-right">

        <a href="#">Instagram</a>
        <a href="#">X</a>

    </div>

</footer>

@section Scripts {
    <script>
        // Enable smooth scrolling via CSS when available
        document.addEventListener('DOMContentLoaded', function () {
            try {
                document.documentElement.style.scrollBehavior = 'smooth';
            } catch (e) { }
        });
    </script>
}
