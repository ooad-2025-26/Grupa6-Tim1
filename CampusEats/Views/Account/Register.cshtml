@model CampusEats.Models.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<h2>Register</h2>

<form asp-action="Register" method="post">
    <div asp-validation-summary="ModelOnly"></div>
    <div>
        <label asp-for="Ime"></label>
        <input asp-for="Ime" />
    </div>
    <div>
        <label asp-for="Prezime"></label>
        <input asp-for="Prezime" />
    </div>
    <div>
        <label asp-for="BrojIndeksa"></label>
        <input asp-for="BrojIndeksa" />
    </div>
    <div>
        <label asp-for="Adresa"></label>
        <input asp-for="Adresa" />
    </div>
    <div>
        <label asp-for="Email"></label>
        <input asp-for="Email" />
    </div>
    <div>
        <label asp-for="Password"></label>
        <input asp-for="Password" type="password" />
    </div>
    <div>
        <label asp-for="ConfirmPassword"></label>
        <input asp-for="ConfirmPassword" type="password" />
    </div>
    <button type="submit">Register</button>
</form>
