@model Meni

@{
    ViewData["Title"] = "Detalji menija";
}

<div class="page-heading">
    <p class="eyebrow">Detalji</p>
    <h1>@Model.Datum.ToString("dd.MM.yyyy")</h1>
</div>

<section class="details-panel">
    <dl>
        <dt>Obrok</dt>
        <dd>@Model.Obrok?.Naziv</dd>
        <dt>Cijena</dt>
        <dd>@Model.Obrok?.Cijena.ToString("0.00") KM</dd>
        <dt>Dostupnost</dt>
        <dd>@(Model.Obrok?.Dostupan == true ? "Dostupno" : "Nedostupno")</dd>
    </dl>
    <a class="btn btn-outline-secondary" asp-action="Index">Nazad</a>
</section>
