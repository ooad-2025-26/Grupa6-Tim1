<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - CampusEats</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body>

    <nav class="ce-navbar">
        <div class="ce-left">
            <a class="ce-logo" asp-controller="Home" asp-action="Index">CampusEats</a>
        </div>

        <div class="ce-nav-links">
            @if (!(User?.Identity?.IsAuthenticated ?? false))
            {
                <a asp-controller="Home" asp-action="Index" asp-fragment="how">How it works</a>
                <a asp-controller="Home" asp-action="Index" asp-fragment="popular-food">Menu</a>
                <a asp-controller="Home" asp-action="Index" asp-fragment="benefits">Benefits</a>
                <a asp-controller="Home" asp-action="Index" asp-fragment="about">About</a>
                <a asp-controller="Account" asp-action="Login" class="ce-link">Order</a>
            }
            else
            {
                // role-specific nav links
                if (User.IsInRole("Student"))
                {
                    <a asp-controller="Obrok" asp-action="Index">Menu</a>
                    <a asp-controller="Rezervacija" asp-action="Index">My Reservations</a>
                    <a asp-controller="QRKod" asp-action="Index">QR Codes</a>
                    <a asp-controller="Profile" asp-action="Index">Profile</a>
                }
                else if (User.IsInRole("Radnik"))
                {
                    <a asp-controller="Obrok" asp-action="Index">Meals</a>
                    <a asp-controller="Meni" asp-action="Index">Menus</a>
                    <a asp-controller="Rezervacija" asp-action="Index">Reservations</a>
                    <a asp-controller="Zaliha" asp-action="Index">Stock</a>
                    <a asp-controller="Profile" asp-action="Index">Profile</a>
                }
                else if (User.IsInRole("Dostavljac"))
                {
                    <a asp-controller="Dostava" asp-action="Index">Deliveries</a>
                    <a asp-controller="Dostava" asp-action="Index">Delivery Status</a>
                    <a asp-controller="Profile" asp-action="Index">Profile</a>
                }
                else if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Admin" asp-action="Dashboard">Dashboard</a>
                    <a asp-controller="Admin" asp-action="Users">Users</a>
                    <a asp-controller="Admin" asp-action="Roles">Roles</a>
                    <a asp-controller="Obrok" asp-action="Index">Meals</a>
                    <a asp-controller="Meni" asp-action="Index">Menus</a>
                    <a asp-controller="Rezervacija" asp-action="Index">Reservations</a>
                    <a asp-controller="Dostava" asp-action="Index">Deliveries</a>
                    <a asp-controller="Zaliha" asp-action="Index">Stock</a>
                    <a asp-controller="Profile" asp-action="Index">Profile</a>
                }
            }
        </div>

        <div class="ce-right">
            @if (User?.Identity?.IsAuthenticated ?? false)
            {
                <span class="text-white">Hello @User.Identity.Name</span>
                <form class="ce-form" asp-controller="Account" asp-action="Logout" method="post" id="logoutForm">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="ce-link-button">Logout</button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login">Login</a>
                <a asp-controller="Account" asp-action="Register">Register</a>
            }
        </div>
    </nav>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
