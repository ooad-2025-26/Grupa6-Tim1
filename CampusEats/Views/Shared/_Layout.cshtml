<body>

    <nav class="ce-navbar">
        <div class="ce-left">
            <a class="ce-logo" asp-controller="Home" asp-action="Index">CampusEats</a>
        </div>

        <div class="nav-center">
            <a asp-controller="Home" asp-action="Index" asp-fragment="how">How it works</a>
            <a asp-controller="Home" asp-action="Index" asp-fragment="popular-food">Menu</a>
            <a asp-controller="Home" asp-action="Index" asp-fragment="benefits">Benefits</a>
            <a asp-controller="Home" asp-action="Index" asp-fragment="about">About</a>
            @if (User?.Identity?.IsAuthenticated ?? false)
            {
                <a asp-controller="Rezervacija" asp-action="Create">Order</a>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="~/Rezervacija/Create">Order</a>
            }
        </div>

        <div class="ce-right">
            @if (User?.Identity?.IsAuthenticated ?? false)
            {
                <span class="text-white">Hello @User.Identity.Name</span>
                <form class="ce-form" asp-controller="Account" asp-action="Logout" method="post" id="logoutForm">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="ce-link-button">Log out</button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login">Login</a>
                <a asp-controller="Account" asp-action="Register">Register</a>
            }
        </div>
    </nav>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
